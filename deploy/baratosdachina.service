[Unit]
Description=Baratos da China - Fly Trap checkout
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/baratosdachina
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3100
EnvironmentFile=/etc/baratosdachina.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
